NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
# Alternatively use NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY instead of the line above.
# Server only. Required for the explicit account deletion workflow.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
# Optional daily abandoned-photo cleanup; configure a scheduler as documented.
CRON_SECRET=
# Optional integration/E2E tests; dedicated nonproduction users only.
E2E_EMAIL=
E2E_PASSWORD=
E2E_OTHER_EMAIL=
E2E_OTHER_PASSWORD=
